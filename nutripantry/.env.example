PGHOST=localhost
PGPORT=5432
PGDATABASE=nutripantry
PGUSER=nutripantry
# Set your own password here. Docker Compose must use this same file.
PGPASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: leave empty until the embedding service is implemented.
EMBEDDING_API_URL=
EMBEDDING_MODEL=all-MiniLM-L6-v2
