PGHOST=localhost
PGPORT=5432
PGDATABASE=nutripantry
PGUSER=nutripantry
# Set your own password here. Docker Compose must use this same file.
PGPASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Embeddings run locally (all-MiniLM-L6-v2 via Transformers.js); no key needed.
# The model downloads once on first use. Optional: set this to a folder that
# already contains Xenova/all-MiniLM-L6-v2 to work fully offline.
EMBEDDING_LOCAL_MODEL_PATH=
